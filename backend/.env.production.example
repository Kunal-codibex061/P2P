NODE_ENV=production
PORT=8080

# MongoDB Atlas connection string (backend only, never in frontend)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/rentora_v1?retryWrites=true&w=majority

# Use a long random value (32+ chars)
JWT_SECRET=replace-with-long-random-secret

# Comma separated allowlist
FRONTEND_URL=https://app.example.com,https://www.app.example.com

# Always false in production
SEED_ON_START=false

# Firebase server-side verification key
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Optional: set when running behind reverse proxy/custom domain to generate absolute file URLs
BACKEND_PUBLIC_URL=https://api.example.com
